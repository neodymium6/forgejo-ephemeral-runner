{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "{{ .PodName }}",
    "namespace": "{{ .Namespace }}",
    "labels": {
      "app.kubernetes.io/name": "forgejo-ephemeral-runner",
      "app.kubernetes.io/component": "job",
      "app.kubernetes.io/managed-by": "forgejo-ephemeral-runner",
      "forgejo-ephemeral-runner.dev/slot": "{{ .Slot }}"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "serviceAccountName": "forgejo-runner-job",
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 30,
    "securityContext": {
      "fsGroup": 65532,
      "fsGroupChangePolicy": "OnRootMismatch",
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "runner",
        "image": "{{ .RunnerImage }}",
        "imagePullPolicy": "IfNotPresent",
        "command": ["/bin/forgejo-ephemeral-one-job"],
        "envFrom": [
          {
            "configMapRef": {
              "name": "forgejo-runner-settings"
            }
          }
        ],
        "env": [
          {
            "name": "HOME",
            "value": "/home/runner"
          },
          {
            "name": "TMPDIR",
            "value": "/tmp"
          },
          {
            "name": "NIX_CONFIG",
            "value": "experimental-features = nix-command flakes\nsandbox = false\n"
          }
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": ["ALL"]
          },
          "readOnlyRootFilesystem": false,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532
        },
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "512Mi",
            "ephemeral-storage": "2Gi"
          },
          "limits": {
            "cpu": "1500m",
            "memory": "1280Mi",
            "ephemeral-storage": "16Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "runner-config",
            "mountPath": "/etc/forgejo-runner",
            "readOnly": true
          },
          {
            "name": "runner-credential",
            "mountPath": "/run/secrets/forgejo-runner",
            "readOnly": true
          },
          {
            "name": "workspace",
            "mountPath": "/workspace"
          },
          {
            "name": "home",
            "mountPath": "/home/runner"
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "runner-config",
        "configMap": {
          "name": "forgejo-runner-config"
        }
      },
      {
        "name": "runner-credential",
        "secret": {
          "secretName": "{{ .CredentialSecretName }}",
          "defaultMode": 288
        }
      },
      {
        "name": "workspace",
        "emptyDir": {"sizeLimit": "4Gi"}
      },
      {
        "name": "home",
        "emptyDir": {"sizeLimit": "1Gi"}
      },
      {
        "name": "tmp",
        "emptyDir": {"sizeLimit": "2Gi"}
      }
    ]
  }
}
