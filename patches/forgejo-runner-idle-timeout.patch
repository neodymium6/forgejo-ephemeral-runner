+func TestSingleTaskPollerIdleDeadline(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		firstError error
+		firstNil   bool
+		task       bool
+	}{
+		{name: "cancelled before assignment"},
+		{name: "assignment wins over elapsed deadline", task: true},
+		{name: "lost assignment response is recovered", firstError: context.DeadlineExceeded, task: true},
+		{name: "missing response is retried", firstNil: true, task: true},
+		{name: "transient failure followed by confirmed empty response", firstError: connect.NewError(connect.CodeUnavailable, errors.New("unavailable"))},
+		{name: "generic authentication failure is retried", firstError: connect.NewError(connect.CodeUnauthenticated, errors.New("temporary gateway failure")), task: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Setenv("FORGEJO_RUNNER_IDLE_TIMEOUT", "1ns")
+			handle := "reserved-job-attempt"
+			c := mock_client.NewMockClient(t)
+			c.On("Address").Return("https://forgejo.example.com")
+			c.On("FetchInterval").Return(time.Nanosecond)
+			var keys []gouuid.UUID
+			c.On("SetRequestKey", mock.Anything).Run(func(args mock.Arguments) {
+				keys = append(keys, args.Get(0).(gouuid.UUID))
+			}).Return(func() {})
+			request := connect.NewRequest(&runnerv1.FetchSingleTaskRequest{Handle: &handle})
+			if test.firstError != nil {
+				c.On("FetchSingleTask", mock.Anything, request).Return(nil, test.firstError).Once()
+			}
+			if test.firstNil {
+				c.On("FetchSingleTask", mock.Anything, request).Return(nil, nil).Once()
+			}
+			var task *runnerv1.Task
+			if test.task {
+				task = &runnerv1.Task{Id: 42}
+			}
+			c.On("FetchSingleTask", mock.Anything, request).Return(connect.NewResponse(&runnerv1.FetchSingleTaskResponse{Task: task}), nil).Once()
+			r := mock_runner.NewMockRunner(t)
+			if test.task {
+				r.On("Run", mock.Anything, task).Run(func(args mock.Arguments) {
+					// The idle deadline must not be inherited by an assigned task.
+					ctx := args.Get(0).(context.Context)
+					require.NoError(t, ctx.Err())
+					_, hasDeadline := ctx.Deadline()
+					require.False(t, hasDeadline)
+				})
+			}
+			p := NewSingleTaskPoller(t.Context(), &config.Config{Runner: config.Runner{FetchTimeout: time.Second}}, c, r, true, &handle)
+			err := p.Poll()
+			if test.task {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, ErrNoTaskReceived)
+			}
+			if test.firstError != nil || test.firstNil {
+				require.Len(t, keys, 2)
+				require.Equal(t, keys[0], keys[1], "ambiguous requests must retain their idempotency key")
+			}
+			require.NoError(t, p.Shutdown(t.Context()))
+		})
+	}
+}
+
+func TestSingleTaskPollerInvalidIdleTimeout(t *testing.T) {
+	for _, value := range []string{"0s", "-1s", "invalid"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("FORGEJO_RUNNER_IDLE_TIMEOUT", value)
+			handle := "reserved-job-attempt"
+			p := NewSingleTaskPoller(t.Context(), &config.Config{}, nil, nil, true, &handle)
+			require.ErrorContains(t, p.Poll(), "positive duration")
+			require.NoError(t, p.Shutdown(t.Context()))
+		})
+	}
+}
