+// SPDX-License-Identifier: MIT
+
+package report
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	runnerv1 "code.forgejo.org/forgejo/actions-proto/runner/v1"
+	"code.forgejo.org/forgejo/runner/v12/internal/pkg/client/mocks"
+	"code.forgejo.org/forgejo/runner/v12/internal/pkg/common"
+	"code.forgejo.org/forgejo/runner/v12/internal/pkg/config"
+	"connectrpc.com/connect"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+func TestReporterStopsOnlyOnExplicitRevocation(t *testing.T) {
+	for _, method := range []string{"UpdateTask", "UpdateLog"} {
+		for _, test := range []struct {
+			name      string
+			code      connect.Code
+			message   string
+			cancelled bool
+		}{
+			{"revoked", connect.CodeUnauthenticated, "unregistered runner", true},
+			{"gateway authentication", connect.CodeUnauthenticated, "unauthorized", false},
+			{"temporary failure", connect.CodeUnavailable, "unregistered runner", false},
+		} {
+			t.Run(method+"/"+test.name, func(t *testing.T) {
+				ctx, cancel := context.WithCancel(t.Context())
+				defer cancel()
+				c := mocks.NewMockClient(t)
+				err := connect.NewError(test.code, errors.New(test.message))
+				c.On(method, mock.Anything, mock.Anything).Return(nil, err).Once()
+				r := NewReporter(common.WithDaemonContext(ctx, t.Context()), cancel, c,
+					&runnerv1.Task{Context: &structpb.Struct{}}, time.Second, &config.Retry{})
+				if method == "UpdateTask" {
+					require.ErrorIs(t, r.ReportState(false), err)
+				} else {
+					require.ErrorIs(t, r.ReportLog(true), err)
+				}
+				require.Equal(t, test.cancelled, ctx.Err() != nil)
+			})
+		}
+	}
+}
+
+func TestReporterDoesNotRetryRevokedFinalReports(t *testing.T) {
+	for _, method := range []string{"UpdateLog", "UpdateTask"} {
+		t.Run(method, func(t *testing.T) {
+			r, c, _ := mockReporter(t)
+			r.retry = &config.Retry{MaxRetries: 3, InitialDelay: time.Nanosecond}
+			err := connect.NewError(connect.CodeUnauthenticated, errors.New("unregistered runner"))
+			if method == "UpdateTask" {
+				c.On("UpdateLog", mock.Anything, mock.Anything).Return(connect.NewResponse(&runnerv1.UpdateLogResponse{AckIndex: 1}), nil).Once()
+			}
+			c.On(method, mock.Anything, mock.Anything).Return(nil, err).Once()
+			require.Error(t, r.Close(context.Canceled))
+			c.AssertNumberOfCalls(t, method, 1)
+		})
+	}
+}
