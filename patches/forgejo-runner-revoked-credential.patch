+// SPDX-License-Identifier: MIT
+
+package client
+
+import (
+	"errors"
+
+	"connectrpc.com/connect"
+)
+
+// IsRunnerUnregistered recognizes Forgejo 15's explicit credential revocation.
+// Generic HTTP authentication failures and transient API errors are not proof.
+func IsRunnerUnregistered(err error) bool {
+	var rpcErr *connect.Error
+	return errors.As(err, &rpcErr) && rpcErr.Code() == connect.CodeUnauthenticated &&
+		rpcErr.Message() == "unregistered runner"
+}
