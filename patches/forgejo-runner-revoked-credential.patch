+func TestSingleTaskPollerUnregistered(t *testing.T) {
+	t.Setenv("FORGEJO_RUNNER_IDLE_TIMEOUT", "1h")
+	c := mock_client.NewMockClient(t)
+	c.On("Address").Return("https://forgejo.example.com")
+	c.On("FetchInterval").Return(time.Nanosecond)
+	c.On("SetRequestKey", mock.Anything).Return(func() {})
+	c.On("FetchSingleTask", mock.Anything, mock.Anything).Return(nil, connect.NewError(connect.CodeUnauthenticated, errors.New("unregistered runner"))).Once()
+	r := mock_runner.NewMockRunner(t)
+	handle := "reserved-job-attempt"
+	p := NewSingleTaskPoller(t.Context(), &config.Config{}, c, r, true, &handle)
+	require.NoError(t, p.Poll())
+	require.NoError(t, p.Shutdown(t.Context()))
+}
